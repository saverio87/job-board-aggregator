<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily job-board run.

    cp deploy/com.jobboard.aggregator.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.jobboard.aggregator.plist

  launchd rather than cron: cron silently skips a job if the machine was asleep at
  the appointed minute, while StartCalendarInterval runs the missed job on wake.
  For a laptop that gets closed, that is the difference between running daily and
  running only on the days you happened to be at the desk.

  Verify the Python path below matches your interpreter (`which python3`).
  Logs land in data/, which is gitignored.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobboard.aggregator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/sav87/Desktop/AI/learn/job-board-aggregator/run.py</string>
    <string>all</string>
    <string>--publish</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sav87/Desktop/AI/learn/job-board-aggregator</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/sav87/Desktop/AI/learn/job-board-aggregator/data/run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sav87/Desktop/AI/learn/job-board-aggregator/data/run.log</string>

  <!--
    Run at load as well as on the schedule. This is the catch-up: if the machine
    was shut down at 07:30 the calendar event is lost entirely, so the job runs on
    the next boot or login instead. It is not expensive — cadence is compared by
    calendar date, so a run that already happened today does nothing.
  -->
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
